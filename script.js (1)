const chatBox = document.getElementById('chatBox');
const userInput = document.getElementById('userInput');
const sendBtn = document.getElementById('sendBtn');
const newChatBtn = document.getElementById('newChatBtn');

// Lưu lịch sử hội thoại để AI nhớ ngữ cảnh (giống ChatGPT)
let conversationHistory = [];

// Tin nhắn hệ thống định hình tính cách Rika
const SYSTEM_PROMPT = `Bạn là Rika, một trợ lý AI thân thiện, thông minh và hữu ích.
Bạn trả lời bằng tiếng Việt tự nhiên, ngắn gọn nhưng đầy đủ ý.
Nếu người dùng hỏi bằng ngôn ngữ khác, hãy trả lời bằng ngôn ngữ đó.
Bạn có thể giải thích khái niệm, viết code, dịch, tóm tắt, và trò chuyện như một người bạn.`;

// Gửi tin nhắn
sendBtn.addEventListener('click', sendMessage);
userInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !sendBtn.disabled) sendMessage();
});

// Reset cuộc trò chuyện
newChatBtn.addEventListener('click', () => {
    conversationHistory = [];
    chatBox.innerHTML = `
        <div class="welcome-box" id="welcomeBox">
            <h1>Xin chào! Mình là Rika 👋</h1>
            <p>Trợ lý AI cá nhân của bạn. Hôm nay mình có thể giúp gì cho bạn?</p>
        </div>
    `;
    userInput.value = '';
    userInput.focus();
});

async function sendMessage() {
    const text = userInput.value.trim();
    if (!text) return;

    // Ẩn welcome box
    const welcome = document.getElementById('welcomeBox');
    if (welcome) welcome.remove();

    // Hiển thị tin nhắn người dùng
    appendMessage(text, 'user-message');
    userInput.value = '';
    scrollToBottom();

    // Khóa nút gửi trong lúc AI trả lời
    sendBtn.disabled = true;
    userInput.disabled = true;

    // Tạo bong bóng AI rỗng để stream chữ vào
    const aiBubbleId = 'ai_' + Date.now();
    const aiBubble = document.createElement('div');
    aiBubble.className = 'message ai-message';
    aiBubble.id = aiBubbleId;
    aiBubble.textContent = 'Rika đang suy nghĩ...';
    chatBox.appendChild(aiBubble);
    scrollToBottom();

    // Thêm tin nhắn user vào lịch sử
    conversationHistory.push({ role: 'user', content: text });

    try {
        // Gọi Gemini qua Puter.js (không cần API key)
        const response = await puter.ai.chat(
            [
                { role: 'system', content: SYSTEM_PROMPT },
                ...conversationHistory
            ],
            {
                model: 'google/gemini-2.5-flash',
                stream: true,
                temperature: 0.7
            }
        );

        // Stream từng phần chữ vào bong bóng
        let fullReply = '';
        let firstChunk = true;

        for await (const part of response) {
            if (part?.text) {
                if (firstChunk) {
                    aiBubble.textContent = '';
                    firstChunk = false;
                }
                aiBubble.textContent += part.text;
                fullReply += part.text;
                scrollToBottom();
            }
        }

        // Lưu câu trả lời của AI vào lịch sử để nhớ ngữ cảnh
        conversationHistory.push({ role: 'assistant', content: fullReply });

    } catch (error) {
        console.error('Lỗi gọi AI:', error);
        aiBubble.textContent = 'Xin lỗi, mình đang gặp chút trục trặc. Bạn thử lại nhé!';
    } finally {
        // Mở khóa input
        sendBtn.disabled = false;
        userInput.disabled = false;
        userInput.focus();
    }
}

function appendMessage(text, className) {
    const div = document.createElement('div');
    div.className = `message ${className}`;
    div.textContent = text;
    chatBox.appendChild(div);
    return div;
}

function scrollToBottom() {
    chatBox.scrollTop = chatBox.scrollHeight;
}

// Focus input khi mở trang
userInput.focus();